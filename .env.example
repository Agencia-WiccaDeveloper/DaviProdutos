# ============================================================
# DAVI PRODUTOS - variaveis de ambiente (modelo)
# Copie para .env.local (dev) ou configure no painel de deploy.
# NUNCA coloque valores reais neste arquivo (ele vai para o Git).
# ============================================================

# Banco de dados MySQL
DATABASE_URL="mysql://usuario:senha@host:3306/davi_produtos"

# Autenticacao (JWT) - gere um segredo forte e aleatorio
AUTH_SECRET=""

# Login com Google (OAuth 2.0)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Pagamento - Mercado Pago (TESTE nesta fase; producao depois)
# Access Token: SOMENTE no servidor (nunca exponha no browser).
MERCADO_PAGO_ACCESS_TOKEN=""
# Public Key do Mercado Pago: pode ser exposta no browser (usada pelo SDK.js
# para tokenizar o cartao no Card Payment Brick). Prefixo NEXT_PUBLIC_ de proposito.
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=""
# (Opcional) Segredo opcional do webhook caso ative assinatura no painel do MP.
MERCADO_PAGO_WEBHOOK_SECRET=""

# E-mail transacional - Resend (a ser integrado)
RESEND_API_KEY=""
EMAIL_FROM="DAVI PRODUTOS <noreply@seudominio.com.br>"

# WhatsApp (notificacao de novos pedidos) - WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ADMIN_PHONE=""

# URL publica do site (usada em links de e-mail e OAuth)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
